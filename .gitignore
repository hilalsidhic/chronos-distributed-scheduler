# --- 1. Global Secrets (Most Important) ---
.env
.env.*
*.secret
*.key

# --- 2. OS & IDE Junk (Applies to whole repo) ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# --- 3. Global Build Artifacts (Safety Net) ---
# Even if a sub-project forgets to ignore these, the root will catch them
**/target/
**/build/
**/node_modules/
**/dist/
**/*.class
**/*.jar